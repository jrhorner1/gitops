server {
        listen {{ nginx.port }} default_server;
        listen [::]:{{ nginx.port }} default_server;

        root {{ nginx.port }};

        server_name {{ nginx.server_name }};

        location / {
                default_type text/plain;
                # First attempt to serve request as file, then
                # as directory, then fall back to displaying a 404.
                try_files $uri $uri/ =404;
                autoindex on;
        }
}